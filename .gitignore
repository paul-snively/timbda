# Bazel workspace links
/bazel-*
# Bazel local caches
/.bazelrc.local
# Vendored pinned deps (synced by tools/ctrees-sync.sh from pins.toml)
/deps/
# Rocq build artifacts
/_build/
/coq/_build/
# coq/lia writes this cache next to the build it ran (M2: Checks.v uses lia)
.lia.cache
*.vo
*.vok
*.vos
*.glob
*.aux
.vo.compiled
# misc
*.log

# OpenCode harness state
.opencode/

# nix build result links
/result*

# Private working notes (local only; never for publication)
docs/_private/

# sweep/TD-sweep captured outputs + python artifacts
_sweeps/
*.err
__pycache__/
