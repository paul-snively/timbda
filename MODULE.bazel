# Timbda-0 Bazel graph (C++ lane). Pin source of truth: tools/pins/pins.toml;
# CI asserts table == this file == .bazelversion == flake.lock.

module(
    name = "timbda",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")

# hermetic-llvm (hermeticbuild/hermetic-llvm via BCR): hermetic clang toolchains
# + LLVM/MLIR built from the pinned source archive. Pins LLVM_VERSION = 23.1.0.
# 2026-11-27 (decision 20, the "one clang law"): the module moved 0.8.27 -> 0.8.23
# so the bazel-side default archive is LLVM/MLIR 23.1.0 - the exact version
# nixpkgs' llvmPackages_23 carries at our pinned nixpkgs rev.  23.1.2 (0.8.24..27)
# was measured absent from nixpkgs entirely: the master bump is 23.1.0 -> 23.1.3
# (bac772ef57a2), the stable backport the same jump (d2ae523a695d); no nixpkgs rev
# ever evaluated clang 23.1.2.  The M-1..M2-era builds ran on 0.8.27/23.1.2.
bazel_dep(name = "llvm", version = "0.8.23")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")

# M-1: trivial dialect at hermetic-llvm's default vintage (LLVM/MLIR 23.1.0 since
# the decision-20 alignment; 23.1.2 for the M-1..M2-era record).
# M-2 (watch-out #1): switch to the DCont-vintage llvm-project fork commit
# (tools/pins/pins.toml [llvm_project].dcont_vintage_commit) via
#   llvm.from_git(remote = "https://github.com/byeongjee/llvm-project.git", commit = ...)
# only after re-running the WasmSSA API vintage probe against that commit.
use_repo(llvm, "llvm-project")

register_toolchains("@llvm//toolchain:all")
