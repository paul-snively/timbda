(lang dune 3.21)
(using coq 0.7)
(name timbda-kernel)
(warnings (deprecated_coq_lang disabled))

; Timbda-0 Gallina kernel (M0).  Deps mirror tools/pins/pins.toml, and flake.nix's coqStack
; builds the ones nixpkgs does not ship (coq-ext-lib, paco, rocq-coinduction 1.21, coq-itree,
; rocq-ctree) from the locked inputs; relation-algebra/equations/Stdlib come from nixpkgs.
; Hence `dune build` works in `nix develop .#rocq` with nix only on the host (DEV-3, the
; transitional opam switch, closed 2026-11-18).  `using coq 0.7` is required: coq lang >= 0.8
; compiles with `coqc -boot`, which drops rocq 9.1's implicit Stdlib/user-contrib loadpath.
(package
 (name timbda-kernel)
 (depends
  (rocq-core (>= 9.0))
  (rocq-stdlib (>= 9.0))
  (coq-ext-lib (>= 0.11.3))
  (rocq-coinduction (>= 1.21))
  (rocq-relation-algebra (>= 1.8.0))
  (coq-itree (>= 5.0))
  rocq-ctree))
