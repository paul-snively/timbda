(lang dune 3.21)
(using coq 0.7)
(name timbda-kernel)
(warnings (deprecated_coq_lang disabled))

; Timbda-0 Gallina kernel (M0).  Deps mirror tools/pins/pins.toml.  Today they come
; from the transitional opam switch (DEV-3, docs/DESIGN-NOTES.md sec. 4): Coinduction /
; RelationAlgebra / ExtLib / ITree / Stdlib from the switch, CTree from the vendored
; deps/ctrees via tools/ctrees-sync.sh.  At M-2 the four unpinned ones become flake
; mkRocqDerivation's and nix develop .#rocq supplies them directly.
(package
 (name timbda-kernel)
 (depends
  (rocq-core (>= 9.0))
  (rocq-stdlib (>= 9.0))
  (coq-ext-lib (>= 0.11.3))
  (rocq-coinduction (>= 1.21))
  (rocq-relation-algebra (>= 1.8.0))
  (coq-itree (>= 5.0))
  rocq-ctree))
